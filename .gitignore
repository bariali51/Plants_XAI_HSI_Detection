# ==================================
# Nabtati — .gitignore
# ==================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment & secrets
.env
*.env.local

# Django
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Model files (too large for git — use cloud storage)
# analysis/model_files/*.h5
# analysis/model_files/*.pth
# analysis/model_files/*.onnx

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Misc
.qodo/